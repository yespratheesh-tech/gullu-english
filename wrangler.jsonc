{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gullu-english",
  "compatibility_date": "2025-09-01",
  // Static site: Wrangler uploads ./public as Worker static assets. No Worker script needed.
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
